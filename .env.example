# ---- Copy to .env (main.py does this automatically on first run) and edit ----

# PostgreSQL connection. Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# main.py creates the database for you if the user is allowed to (CREATEDB).
DATABASE_URL=postgresql://voxprice:voxprice@localhost:5432/voxprice

# Google Gemini API key (get one at https://aistudio.google.com/apikey). Stays on the server.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# First administrator, created automatically if no admin exists. CHANGE THE PASSWORD after logging in.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Insert sample customers / quotations / history on a brand-new database (true/false)
SEED_DEMO_DATA=true

HOST=127.0.0.1
PORT=8000

# Set to true when you serve the site over HTTPS (cookies are then marked Secure)
COOKIE_SECURE=false
# Public address used in password-reset links, e.g. https://pricing.example.com (optional)
PUBLIC_URL=

# Optional: SMTP for password-reset emails. If empty, the reset link is printed in the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@voxprice.local

# Optional: fixed secret for session cookies. If empty, one is generated into data/.secret_key
SECRET_KEY=
